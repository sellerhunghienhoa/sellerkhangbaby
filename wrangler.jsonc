{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sellerkhangbaby-live-kpi",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-28",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/oauth/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "TIKTOK_OAUTH_KV",
      "id": "3a78cf302fa64cc4b8b8a3f62c2cb96e"
    }
  ],
  "vars": {
    "FIREBASE_WEB_API_KEY": "AIzaSyABazO0rjLnA8xtK_8p5MGpttNf5xHRYgU"
  },
  "secrets": {
    "required": [
      "TIKTOK_TOKEN_ENCRYPTION_KEY",
      "TIKTOK_SELLER_APP_KEY",
      "TIKTOK_SELLER_APP_SECRET",
      "TIKTOK_CREATOR_APP_KEY",
      "TIKTOK_CREATOR_APP_SECRET",
      "TIKTOK_SHOPKHANGBABY_REFRESH_TOKEN",
      "TIKTOK_MEKHANGSUA_REFRESH_TOKEN"
    ]
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
