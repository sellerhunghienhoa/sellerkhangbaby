{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sellerkhangbaby-live-kpi",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-28",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/oauth/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "TIKTOK_OAUTH_KV",
      "id": "3a78cf302fa64cc4b8b8a3f62c2cb96e"
    }
  ],
  "vars": {
    "FIREBASE_API_KEY": "AIzaSyABazO0rjLnA8xtK_8p5MGpttNf5xHRYgU",
    "FIREBASE_APP_ID": "1:752377017264:web:54e4ffa3a535a9cb0e9c75",
    "FIREBASE_AUTH_DOMAIN": "sellerkhangbaby.firebaseapp.com",
    "FIREBASE_MESSAGING_SENDER_ID": "752377017264",
    "FIREBASE_PROJECT_ID": "sellerkhangbaby",
    "FIREBASE_STORAGE_BUCKET": "sellerkhangbaby.firebasestorage.app",
    "FIREBASE_WEB_API_KEY": "AIzaSyABazO0rjLnA8xtK_8p5MGpttNf5xHRYgU",
    "TIKTOK_APP_KEY": "6llc75tdtivr7",
    "TIKTOK_SERVICE_ID": "7698666392577017620",
    "TIKTOK_SELLER_AUTH_URL": "https://services.tiktokshop.com/open/authorize"
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
