rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'sellerhunghienhoa@gmail.com';
    }

    function isOwnProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validPendingProfile(uid) {
      return isOwnProfile(uid)
        && request.resource.data.keys().hasOnly([
          'id', 'uid', 'name', 'email', 'photoURL', 'authProvider',
          'status', 'role', 'joined', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'PENDING'
        && request.resource.data.role == ''
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
    }

    match /users/{uid} {
      allow get: if isBootstrapAdmin() || isOwnProfile(uid);
      allow list: if isBootstrapAdmin();
      allow create: if isBootstrapAdmin() || validPendingProfile(uid);
      allow update, delete: if isBootstrapAdmin();
    }

    match /production/{document=**} {
      allow read, write: if isBootstrapAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

