rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'sellerhunghienhoa@gmail.com';
    }

    function isOwnProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isApprovedStaff() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return signedIn()
        && profile.data.status == 'APPROVED'
        && profile.data.role in ['HOST', 'OPERATOR'];
    }

    function validPendingProfile(uid) {
      return isOwnProfile(uid)
        && request.resource.data.keys().hasOnly([
          'id', 'uid', 'name', 'email', 'photoURL', 'authProvider',
          'status', 'role', 'joined', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'PENDING'
        && request.resource.data.role == ''
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
    }

    function validOwnTargetUpdate(uid) {
      return isOwnProfile(uid)
        && resource.data.status == 'APPROVED'
        && resource.data.role == 'HOST'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['targetGmv', 'targetUpdatedAt', 'updatedAt'])
        && request.resource.data.targetGmv is int
        && request.resource.data.targetGmv > 0
        && request.resource.data.targetGmv <= 1000000000000
        && request.resource.data.targetUpdatedAt is string
        && request.resource.data.updatedAt is string;
    }

    match /users/{uid} {
      allow get: if isBootstrapAdmin() || isOwnProfile(uid);
      allow list: if isBootstrapAdmin();
      allow create: if isBootstrapAdmin() || validPendingProfile(uid);
      allow update: if isBootstrapAdmin() || validOwnTargetUpdate(uid);
      allow delete: if isBootstrapAdmin();
    }

    match /production/staffDashboard {
      allow read: if isBootstrapAdmin() || isApprovedStaff();
      allow write: if isBootstrapAdmin();
    }

    match /production/staffDashboard/pendingShifts/{shiftId} {
      // Host/Operator được tạo và cập nhật entry của chính mình (PENDING only)
      allow read: if isBootstrapAdmin() || signedIn();
      allow create: if signedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.shiftGmv is number
        && request.resource.data.shiftGmv > 0
        && request.resource.data.hostId is string;
      allow update: if isBootstrapAdmin(); // chỉ Admin approve/reject
      allow delete: if isBootstrapAdmin()
        || (signedIn() && resource.data.submittedBy == request.auth.uid && resource.data.status == 'PENDING');
    }

    match /production/{document=**} {
      allow read, write: if isBootstrapAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

